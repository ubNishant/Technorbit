CREATE DATABASE BBT;
CREATE TABLE STUDENT_INFO(
ID INT,
FIRST_NAME VARCHAR(200),
LAST_NAME VARCHAR(100),
CITY VARCHAR(100),
DBMS_MARKS INT,
OOP_MARKS INT
)
SELECT * FROM STUDENT_INFO;

