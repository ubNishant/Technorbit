SELECT * FROM STUDENT_INFO WHERE FIRST_NAME='SANJAY'

--ALL ABOVE THREE GIVE SAME OUTPUT (WHERE CLAUSE)
SELECT * FROM STUDENT_INFO WHERE STUDENT_INFO.DBMS_MARKS >90
SELECT * FROM STUDENT_INFO SI WHERE SI.DBMS_MARKS >90
SELECT * FROM STUDENT_INFO WHERE DBMS_MARKS>90

-- OTHER QUERIES
-- SI IS ALIAS NAME WE CAN GIVE ANY NAME WE WANT 
--; IS OPTIONAL IN SSMS, IT IS USE ONLY TO INDICTE QUERY IS END

SELECT DBMS_MARKS FROM STUDENT_INFO
SELECT SI.FIRST_NAME, SI.LAST_NAME FROM STUDENT_INFO SI 

SELECT * FROM STUDENT_INFO WHERE OOP_MARKS > 70
SELECT * FROM STUDENT_INFO WHERE OOP_MARKS > 70 AND DBMS_MARKS > 70
SELECT * FROM STUDENT_INFO WHERE ID!=4
SELECT * FROM STUDENT_INFO WHERE CITY='SANGAMNER'
SELECT * FROM STUDENT_INFO SI WHERE SI.CITY='SANGAMNER' 

SELECT * FROM STUDENT_INFO WHERE FIRST_NAME='RAM' OR FIRST_NAME= 'PANKAJ' OR FIRST_NAME= 'NISHANT'
SELECT * FROM STUDENT_INFO SD WHERE (SD.CITY='SANGAMNER' AND SD.DBMS_MARKS > 60 AND SD.OOP_MARKS >60)

-- BRACKET USE ABOVE WHERE CLAUUSE IS OPTIONAL BUT IT USEFUL WHEN WE WRITE LARGE 
--ALSO BELOW SHOWN THE USE OF WHERE CLAUSE

SELECT * FROM STUDENT_INFO SD WHERE SD.CITY='SANGAMNER' OR ( SD.DBMS_MARKS > 90 AND SD.OOP_MARKS > 90 )


--ORDER BY CLAUSE FOR SORTING OF DATA

SELECT * FROM STUDENT_INFO SI ORDER BY SI.DBMS_MARKS DESC
SELECT * FROM STUDENT_INFO SI ORDER BY SI.DBMS_MARKS ASC
SELECT * FROM STUDENT_INFO ORDER BY OOP_MARKS
--DESC IS DESENDIN AND ASC IS ASCENDING IF NOT TAKE ANY THEN BY DEFAULT THERE IS ASC 

SELECT * FROM STUDENT_INFO WHERE CITY='SANGAMNER' ORDER BY DBMS_MARKS DESC

SELECT * FROM STUDENT_INFO WHERE OOP_MARKS > 70 AND DBMS_MARKS > 70 ORDER BY OOP_MARKS 
SELECT * FROM STUDENT_INFO SI WHERE SI.OOP_MARKS > 70 AND SI.DBMS_MARKS > 70 ORDER BY SI.OOP_MARKS DESC
SELECT * FROM STUDENT_INFO SI ORDER BY SI.DBMS_MARKS ASC,SI.OOP_MARKS ASC

SELECT * FROM STUDENT_INFO WHERE CITY='SANGAMNER' ORDER BY DBMS_MARKS DESC,OOP_MARKS DESC
-- IN ABOVE QUERY IF DBMS MARKS ARE SAME FOR SOME ROW THEN IT WILL CHECK FOR OOP  ONLY WHERE DBMS MARKS ARE SAME 
-- IN ABOVE IF DBMS MARKS SAME THEN ONLY CHECK OOP MARKS 
--IF ALL DBMS MARKS ARE UNIQUE THEN WE WILL NWVER CHECK FOR  OOP MARKS


--                  ###CASE WHEN STATEMENT###

-- TO GENRATE RUN TIME COLOUM
--TO SHOW TEMP COLOUM IN UOTPUT BASED ON SOME CONDITION
-- CASE THEN ELSE END

SELECT SI.ID,
SI.FIRST_NAME,
SI.LAST_NAME,
SI.CITY,
SI.DBMS_MARKS,
SI.OOP_MARKS,
CASE
WHEN SI.DBMS_MARKS > 70 AND SI.OOP_MARKS > 70
THEN 'PASS'
ELSE 'FAIL'
END
FROM  STUDENT_INFO SI

SELECT *,
CASE
WHEN SI.DBMS_MARKS > 70 AND SI.OOP_MARKS > 70
THEN 'PASS'
ELSE 'FAIL'
END
FROM  STUDENT_INFO SI

--ABOVE BOTH WILL GIVE SAME OUTPUT (CASE WHEN STATEMENT)


--                   #### USE OF THE AS ####### 

SELECT SI.ID,
SI.FIRST_NAME AS 'STUDENT FIRST NAME',
SI.LAST_NAME AS 'STUDENT LAST NAME',
SI.CITY AS 'NAME OF THE CITY',
SI.DBMS_MARKS AS 'DATABASE MANAGEMET SYSTEM',
SI.OOP_MARKS AS 'OBJECT ORIENTED PROGRAMMING'
FROM  STUDENT_INFO SI
